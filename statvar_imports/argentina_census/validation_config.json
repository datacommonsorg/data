{
    "schema_version": "1.0",
    "rules": [
        {
            "rule_id": "check_min_value",
            "validator": "MIN_VALUE_CHECK",
            "params": {
                "minimum": 0
            }
        },
        {
            "rule_id": "check_Active_Census_max_date_consistency",
            "validator": "MAX_DATE_CONSISTENT",
            "scope": {
                "variables": {
                    "regex": [
                        "^(?!.*(Urban|Rural|Literate|Illiterate|10OrMoreYears|85OrMoreYears|95OrMoreYears|99OrMoreYears))Count_Person.*"
                    ]
                }
            },
            "params": {}
        },
        {
            "rule_id": "check_Active_Census_num_places",
            "validator": "NUM_PLACES_COUNT",
            "scope": {
                "variables": {
                    "regex": [
                        "^(?!.*(Urban|Rural|Literate|Illiterate|10OrMoreYears|85OrMoreYears|95OrMoreYears|99OrMoreYears))Count_Person.*"
                    ]
                }
            },
            "params": {
                "minimum": 25
            }
        },
        {
            "rule_id": "check_Active_Census_num_observations",
            "validator": "NUM_OBSERVATIONS_CHECK",
            "scope": {
                "variables": {
                    "regex": [
                        "^(?!.*(Urban|Rural|Literate|Illiterate|10OrMoreYears|85OrMoreYears|95OrMoreYears|99OrMoreYears))Count_Person.*"
                    ]
                }
            },
            "params": {
                "minimum": 69
            }
        },
        {
            "rule_id": "check_Count_Person_AA2_places",
            "validator": "SQL_VALIDATOR",
            "params": {
                "query": "SELECT COUNT(*) AS NumStatVars, COALESCE(MIN(NumPlaces), 0) AS NumPlaces, COALESCE(MIN(NumObservations), 0) AS NumObservations, COALESCE(MIN(CAST(MaxDate AS INTEGER)), 0) AS LatestDate FROM stats WHERE StatVar = 'Count_Person'",
                "condition": "NumStatVars = 1 AND NumPlaces >= 529 AND NumObservations >= 1600 AND LatestDate >= 2022"
            }
        },
        {
            "rule_id": "check_Infant_Mortality_min_value",
            "validator": "SQL_VALIDATOR",
            "params": {
                "query": "SELECT COUNT(*) AS NumStatVars, COALESCE(MIN(NumObservations), 0) AS MinTotalObs, COALESCE(MIN(CAST(MaxDate AS INTEGER)), 0) AS MinLatestDate FROM stats WHERE StatVar = 'Count_MortalityEvent_AsAFractionOf_Count_BirthEvent_LiveBirth'",
                "condition": "NumStatVars = 1 AND MinTotalObs >= 450 AND MinLatestDate >= 2023"
            }
        }
    ]
}

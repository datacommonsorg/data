            ],
            "import_inputs": [
                {
                    "template_mcf": "output/Investment_output.tmcf",
                    "cleaned_csv": "output/Investment_output.csv",
                    "node_mcf": "output/*.mcf"
                }
            ],
            "source_files": [
                "output/Investment_cleaned.csv",
                "output/raw_usaspending_eda_awards.json",
                "counters/Investment_counters.csv",
                "Investmentmetadata.csv",
                "Investmentpvmap.csv",
                "manifest.json",
                "validation_config.json"

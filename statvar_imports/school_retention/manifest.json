{
  "import_specifications": [
    {
      "import_name": "US_UrbanSchool_Retention",
      "curator_emails": [
        "support@datacommons.org"
      ],
      "provenance_url": "https://civilrightsdata.ed.gov/data",
      "provenance_description": "This data provides an overview of student retention rates, categorized by gender, race/ethnicity, disability status, and language fluency, specifically for School Grades 1 to 12.",
      "scripts": [
        "download_script.py",
        "../../tools/statvar_importer/stat_var_processor.py --existing_statvar_mcf=gs://unresolved_mcf/scripts/statvar/stat_vars.mcf --input_data=input_files/*.csv --pv_map=retention_pvmap.csv --config_file=retention_metadata.csv --output_path=output/retention_output --output_counters=counters/retention_counters.csv --recon_property=variableMeasured --log_level=-2 --log_every_n=1000"
      ],
      "source_files": [
        "raw_input_files/*.csv",
        "raw_input_files/*.xlsx",
        "input_files/*.csv",
        "counters/*.csv",
        "validation_config.json"
      ],
      "import_inputs": [
        {
          "template_mcf": "output/retention_output.tmcf",
          "cleaned_csv": "output/retention_output.csv",
          "node_mcf": "output/*.mcf"
        }
      ],
      "cron_schedule": "30 9 * * 2",
      "_comment": "Schedule: Weekly on Tuesday at 09:30 UTC",
      "validation_config_file": "validation_config.json",
      "resource_limits": {
        "cpu": 16,
        "memory": 128,
        "disk": 500
      }
    }
  ]
}
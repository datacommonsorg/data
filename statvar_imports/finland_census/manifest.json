{
    "import_specifications": [
        {
            "import_name": "Finland_Census",
            "curator_emails": [
                "support@datacommons.org"
            ],
            "provenance_url": "https://pxdata.stat.fi/PxWeb/pxweb/en/StatFin/StatFin__vaerak/",
            "provenance_description": "National statistical data and socio-economic indicators for Finland, provided by Statistics Finland",
            "scripts": [
                "data_download.py --output_path=./input_files/finland_census_input.csv",
                "../../tools/statvar_importer/stat_var_processor.py --input_data=input_files/*.csv --pv_map=finland_census_pvmap.csv --config_file=finland_census_metadata.csv --output_path=output_files/finland_census_output --existing_statvar_mcf=gs://unresolved_mcf/scripts/statvar/stat_vars.mcf --output_counters=counters/finland_census.csv"
            ],
            "import_inputs": [
                {
                    "template_mcf": "output_files/finland_census_output.tmcf",
                    "cleaned_csv": "output_files/finland_census_output.csv"
                }
            ],
            "source_files": [
                "input_files/*.csv",
                "golden_data/*.csv",
                "counters/*.csv"
            ],
            "cron_schedule": "30 5 1 * *",
            "validation_config_file": "validation_config.json"
        }
    ]
}

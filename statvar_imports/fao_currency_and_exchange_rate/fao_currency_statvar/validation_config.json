{
    "schema_version": "1.0",
    "rules": [
        {
            "rule_id": "check_deleted_records_percent",
            "description": "Checks that the percentage of deleted points is within the 10% threshold.",
            "validator": "DELETED_RECORDS_PERCENT",
            "params": {
                "threshold": 10
            }
        },
        {
            "rule_id": "check_active_currency_date_freshness",
            "description": "Ensure active currencies (EUR, INR, GBP, JPY, CAD, AUD, CHF, CNY) have MaxDate at or after 2025 to catch import stagnation.",
            "validator": "SQL_VALIDATOR",
            "params": {
                "query": "SELECT StatVar, MaxDate FROM stats WHERE regexp_matches(StatVar, '_ToCurrency_(EUR|INR|GBP|JPY|CAD|AUD|CHF|CNY)$')",
                "condition": "SUBSTR(MaxDate, 1, 4) >= '2025'"
            }
        },
        {
            "rule_id": "check_goldens_summary_report",
            "validator": "GOLDENS_CHECK",
            "params": {
                "golden_files": "../../../../golden_data/golden_summary.csv"
            }
        },
        {
            "rule_id": "check_goldens_output_csv",
            "description": "Verifies the generated output CSV data matches established critical golden records",
            "validator": "GOLDENS_CHECK",
            "params": {
                "golden_files": "../../../../golden_data/golden_observation.csv",
                "input_files": "../../../../output_files/CurrencyFAO_output.csv"
            }
        }
    ]
}

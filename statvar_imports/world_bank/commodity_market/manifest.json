{
    "import_specifications": [
        {
            "import_name": "WorldBank_CommodityMarket",
            "curator_emails": [
                "support@datacommons.org"
            ],
            "provenance_url": "https://www.worldbank.org/en/research/commodity-markets",
            "provenance_description": "dataset contains commodity price and its index value for monthly and annual",
            "scripts": [
                "download.py",
                "../../../tools/statvar_importer/stat_var_processor.py --input_data=input/monthly_prices_data.csv --pv_map=commodity_monthly_price_pvmap.csv --config_file=commodity_monthly_price_metadata.csv -output_path=output/commodity_monthly_price --output_counters=counters/monthly_prices_data_counters.csv",
                "../../../tools/statvar_importer/stat_var_processor.py --input_data=input/annual_prices_real_data.csv --pv_map=commodity_annual_price_pvmap_real.csv --config_file=commodity_annual_price_metadata.csv --output_path=output/commodity_annual_real_price --output_counters=counters/annual_prices_real_data_counters.csv",
                "../../../tools/statvar_importer/stat_var_processor.py --input_data=input/annual_prices_nominal_data.csv --pv_map=commodity_annual_price_pvmap_nominal.csv --config_file=commodity_annual_price_metadata.csv --output_path=output/commodity_annual_nominal_price --output_counters=counters/annual_prices_nominal_data_counters.csv",
                "../../../tools/statvar_importer/stat_var_processor.py --input_data=input/monthly_indices_data.csv --pv_map=commodity_monthly_indices_pvmap.csv --config_file=commodity_monthly_indices_metadata.csv --output_path=output/commodity_monthly_indices --output_counters=counters/monthly_indices_data_counters.csv",
                "../../../tools/statvar_importer/stat_var_processor.py --input_data=input/annual_indices_nominal_data.csv --pv_map=commodity_annual_indices_pvmap_nominal.csv --config_file=commodity_annual_indices_metadata.csv --output_path=output/commodity_annual_nominal_indices --output_counters=counters/annual_indices_nominal_data_counters.csv",
                "../../../tools/statvar_importer/stat_var_processor.py --input_data=input/annual_indices_real_data.csv --pv_map=commodity_annual_indices_pvmap_real.csv --config_file=commodity_annual_indices_metadata.csv --output_path=output/commodity_annual_real_indices --output_counters=counters/annual_indices_real_data_counters.csv"
            ],
            "import_inputs": [
                {
                    "template_mcf": "output/commodity_monthly_price.tmcf",
                    "cleaned_csv": "output/commodity_monthly_price.csv"
                },
                {
                    "template_mcf": "output/commodity_annual_real_price.tmcf",
                    "cleaned_csv": "output/commodity_annual_real_price.csv"
                },
                {
                    "template_mcf": "output/commodity_annual_nominal_price.tmcf",
                    "cleaned_csv": "output/commodity_annual_nominal_price.csv"
                },
                {
                    "template_mcf": "output/commodity_monthly_indices.tmcf",
                    "cleaned_csv": "output/commodity_monthly_indices.csv"
                },
                {
                    "template_mcf": "output/commodity_annual_real_indices.tmcf",
                    "cleaned_csv": "output/commodity_annual_real_indices.csv"
                },
                {
                    "template_mcf": "output/commodity_annual_nominal_indices.tmcf",
                    "cleaned_csv": "output/commodity_annual_nominal_indices.csv"
                }
            ],
            "cron_schedule": "0 10 1,15 * *",
            "validation_config_file": "validation_config.json",
            "source_files": [
                "input/*.csv",
                "golden_data/*.csv",
                "counters/*.csv"
            ]
        }
    ]
}
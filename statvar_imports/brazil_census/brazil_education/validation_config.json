{
    "schema_version": "1.0",
    "rules": [
        {
            "rule_id": "check_deleted_records_percent",
            "description": "Checks deleted records threshold.",
            "validator": "DELETED_RECORDS_PERCENT",
            "scope": {
                "data_source": "differ_summary"
            },
            "params": {
                "threshold": 0.1
            }
        },
        {
            "rule_id": "check_max_date_freshness",
            "description": "Checks date freshness across 2010 education cohorts and 2000 PreVestibular.",
            "validator": "SQL_VALIDATOR",
            "scope": {
                "data_source": "stats"
            },
            "params": {
                "query": "SELECT StatVar, MaxDate, COUNT(*) OVER () AS total_svs FROM stats",
                "condition": "((StatVar = 'Count_Student_BrazilPreVestibular' AND MaxDate >= '2000') OR (StatVar != 'Count_Student_BrazilPreVestibular' AND MaxDate >= '2010')) AND total_svs > 0"
            }
        },
        {
            "rule_id": "check_max_date_consistent",
            "description": "Checks date consistency across 2010 education StatVars.",
            "validator": "MAX_DATE_CONSISTENT",
            "scope": {
                "data_source": "stats",
                "variables": {
                    "regex": [
                        "^(?!Count_Student_BrazilPreVestibular$).*$"
                    ]
                }
            },
            "params": {}
        },
        {
            "rule_id": "check_num_places_count",
            "description": "Checks that every education StatVar covers at least 33 places.",
            "validator": "NUM_PLACES_COUNT",
            "scope": {
                "data_source": "stats"
            },
            "params": {
                "minimum": 33
            }
        }
    ]
}

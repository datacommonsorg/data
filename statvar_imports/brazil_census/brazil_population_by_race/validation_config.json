{
    "schema_version": "1.0",
    "rules": [
        {
            "rule_id": "check_deleted_records_percent",
            "description": "Checks deleted records threshold.",
            "validator": "DELETED_RECORDS_PERCENT",
            "scope": {
                "data_source": "differ_summary"
            },
            "params": {
                "threshold": 0.1
            }
        },
        {
            "rule_id": "check_max_date_freshness",
            "description": "Checks date freshness across active 2022 race cohorts and historical UnknownRace.",
            "validator": "SQL_VALIDATOR",
            "scope": {
                "data_source": "stats"
            },
            "params": {
                "query": "SELECT StatVar, MaxDate, COUNT(*) OVER () AS total_svs FROM stats",
                "condition": "((StatVar = 'Count_Person_UnknownRace' AND MaxDate >= '2000') OR (StatVar != 'Count_Person_UnknownRace' AND MaxDate >= '2022')) AND total_svs > 0"
            }
        },
        {
            "rule_id": "check_max_date_consistent",
            "description": "Checks date consistency across active 2022 race StatVars.",
            "validator": "MAX_DATE_CONSISTENT",
            "scope": {
                "data_source": "stats",
                "variables": {
                    "regex": [
                        "^(?!Count_Person_UnknownRace$).*$"
                    ]
                }
            },
            "params": {}
        },
        {
            "rule_id": "check_num_places_consistent",
            "description": "Checks place count consistency (33 entities).",
            "validator": "NUM_PLACES_CONSISTENT",
            "scope": {
                "data_source": "stats"
            },
            "params": {}
        }
    ]
}

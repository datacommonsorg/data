{
    "schema_version": "1.0",
    "rules": [
        {
            "rule_id": "check_deleted_records_percent",
            "description": "Checks that deleted records do not exceed 0.1%.",
            "validator": "DELETED_RECORDS_PERCENT",
            "scope": {
                "data_source": "differ_summary"
            },
            "params": {
                "threshold": 0.1
            }
        },
        {
            "rule_id": "check_max_date_consistent",
            "description": "Checks if the MaxDate is the same for all StatVars.",
            "validator": "MAX_DATE_CONSISTENT",
            "scope": {
                "data_source": "stats"
            },
            "params": {}
        },
        {
            "rule_id": "check_max_date_freshness",
            "description": "Verifies that MaxDate meets the expected freshness threshold for the dataset.",
            "validator": "SQL_VALIDATOR",
            "scope": {
                "data_source": "stats"
            },
            "params": {
                "query": "SELECT StatVar, MaxDate, COUNT(*) OVER () AS total_svs FROM stats",
                "condition": "MaxDate >= '2022' AND total_svs > 0"
            }
        },
        {
            "rule_id": "check_num_places_consistent",
            "description": "Verifies that all StatVars have the same number of places (33 entities).",
            "validator": "NUM_PLACES_CONSISTENT",
            "scope": {
                "data_source": "stats"
            },
            "params": {}
        }
    ]
}
{
  "schema_version": "1.0",
  "rules": [
    {
      "rule_id": "check_max_date_consistent",
      "description": "Checks that the latest date is identical across all 7 ERA5 monthly StatVars.",
      "validator": "MAX_DATE_CONSISTENT",
      "params": {}
    },
    {
      "rule_id": "check_min_date_historical",
      "description": "Checks that historical baseline observations from 1979-01 are included.",
      "validator": "SQL_VALIDATOR",
      "params": {
        "query": "SELECT StatVar, MinDate FROM stats",
        "condition": "MinDate <= '1979-01'"
      }
    },
    {
      "rule_id": "check_max_date_freshness",
      "description": "Checks that the latest observation date is within the last 3 months.",
      "validator": "SQL_VALIDATOR",
      "params": {
        "query": "SELECT StatVar, MaxDate FROM stats",
        "condition": "MaxDate >= strftime(current_date - INTERVAL 3 MONTH, '%Y-%m')"
      }
    },
    {
      "rule_id": "check_num_places_consistent",
      "description": "Checks that the number of places is consistent across all 7 ERA5 monthly StatVars.",
      "validator": "NUM_PLACES_CONSISTENT",
      "params": {}
    }
  ]
}

{
    "import_specifications": [
        {
            "import_name": "DynamicWorld_Floods",
            "curator_emails": [
                "support@datacommons.org"
            ],
            "provenance_url": "https://developers.google.com/earth-engine/datasets/catalog/GOOGLE_DYNAMICWORLD_V1",
            "provenance_description": "Floods regions inferred from areas marked with high probability of water outside the permanent water bodies.",
            "scripts": [
                "download_script.py",
                "../../../tools/statvar_importer/stat_var_processor.py --input_data=input_files/dynamic_world_flood_s2_svobs.csv --pv_map=dynamic_world_flood_pvmap.csv --config_file=dynamic_world_flood_metadata.csv --output_path=output/dynamic_world_flood_output --existing_statvar_mcf=gs://unresolved_mcf/scripts/statvar/stat_vars.mcf --output_counters=counters/dynamic_world_flood_counters.csv"
            ],
            "import_inputs": [
                {
                    "template_mcf": "output/dynamic_world_flood_output.tmcf",
                    "cleaned_csv": "output/dynamic_world_flood_output.csv",
                    "node_mcf": "output/*.mcf"
                }
            ],
            "source_files": [
                "input_files/dynamic_world_flood_s2_svobs.csv",
                "counters/*.csv",
                "dynamic_world_flood_pvmap.csv",
                "dynamic_world_flood_metadata.csv",
                "validation_config.json"
            ],
            "validation_config_file": "validation_config.json",
            "cron_schedule": "0 8 2 * *",
            "user_script_timeout": 7200,
            "resource_limits": {
                "cpu": 8,
                "memory": 32,
                "disk": 100
            }
        }
    ]
}

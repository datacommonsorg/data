{
    "schema_version": "1.0",
    "rules": [
        {
            "rule_id": "check_max_date_consistent",
            "description": "Verifies that MaxDate is uniform across all generated StatVars.",
            "validator": "MAX_DATE_CONSISTENT",
            "params": {}
        },
        {
            "rule_id": "check_all_statvars_freshness",
            "description": "Verify all active StatVars meet the freshness boundary (MaxDate >= '2025').",
            "validator": "SQL_VALIDATOR",
            "params": {
                "query": "SELECT StatVar, MaxDate FROM stats",
                "condition": "MaxDate >= '2025'"
            }
        },
        {
            "rule_id": "check_deleted_records_percent",
            "description": "Checks that deleted records do not exceed 0.1%.",
            "validator": "DELETED_RECORDS_PERCENT",
            "params": {
                "threshold": 0.1
            }
        }
    ]
}

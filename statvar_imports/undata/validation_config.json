{
  "schema_version": "1.0",
  "rules": [
    {
      "rule_id": "check_deleted_records_percent",
      "description": "Checks that the percentage of deleted points is within the threshold.",
      "validator": "DELETED_RECORDS_PERCENT",
      "params": {
        "threshold": 0.1
      }
    },
    {
      "rule_id": "check_max_date_consistent",
      "description": "Checks that the latest date is identical across all StatVars.",
      "validator": "MAX_DATE_CONSISTENT"
    },
    {
      "rule_id": "check_max_date_freshness",
      "description": "Checks that the latest observation year is within a 2-year lag of the current year (>= CURRENT_YEAR - 2) for all StatVars.",
      "validator": "SQL_VALIDATOR",
      "params": {
        "query": "SELECT StatVar, MaxDate FROM stats",
        "condition": "TRY_CAST(SUBSTR(TRIM(MaxDate), 1, 4) AS INTEGER) >= date_part('year', CURRENT_DATE) - 2"
      }
    }
  ]
}
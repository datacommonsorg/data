{
    "schema_version": "1.0",
    "rules": [
        {
            "rule_id": "check_deleted_records_percent",
            "description": "Threshold set to 0.1% to guard against unexpected series deletions.",
            "validator": "DELETED_RECORDS_PERCENT",
            "params": {
                "threshold": 0.1
            }
        },
        {
            "rule_id": "check_max_date_consistent",
            "description": "Ensures all StatVars share a uniform latest observation year.",
            "validator": "MAX_DATE_CONSISTENT"
        },
        {
            "rule_id": "check_max_date_freshness",
            "description": "Verifies that all StatVars reach the expected observation year of at least 2026.",
            "validator": "SQL_VALIDATOR",
            "params": {
                "query": "SELECT StatVar, MaxDate FROM stats",
                "condition": "MaxDate >= '2026'"
            }
        }
    ]
}

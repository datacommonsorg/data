{
    "import_specifications": [
        {
            "import_name": "MOSPI_IndiaPLFS_MonthlyWages",
            "curator_emails": [
                "support@datacommons.org"
            ],
            "provenance_url": "https://esankhyiki.mospi.gov.in/macroindicators?product=plfs",
            "provenance_description": "Periodic Labour Force Survey (PLFS) average monthly wage/salary earnings from regular wage/salaried employment in India from the Ministry of Statistics and Programme Implementation (MoSPI).",
            "scripts": [
                "download.py",
                "../../../../tools/statvar_importer/stat_var_processor.py --input_data=input_files/monthly_wages_input.csv --pv_map=monthly_wages_pvmap.csv --config_file=monthly_wages_metadata.csv --places_resolved_csv=monthly_wages_places.csv --existing_statvar_mcf=gs://unresolved_mcf/scripts/statvar/stat_vars.mcf --output_path=output/monthly_wages_output --output_counters=counters/monthly_wages_counters.csv"
            ],
            "import_inputs": [
                {
                    "template_mcf": "output/monthly_wages_output.tmcf",
                    "cleaned_csv": "output/monthly_wages_output.csv",
                    "node_mcf": "output/*.mcf"
                }
            ],
            "source_files": [
                "input_files/*.csv",
                "counters/*.csv"
            ],
            "cron_schedule": "0 3 * * 1",
            "validation_config_file": "validation_config.json"
        }
    ]
}

{
    "import_specifications": [
        {
            "import_name": "OpportunityInsightsOutcomes",
            "curator_emails": [
                "support@datacommons.org"
            ],
            "provenance_url": "https://opportunityinsights.org/data/",
            "provenance_description": "The Opportunity Atlas (Opportunity Insights) social and economic mobility outcomes by childhood commuting zone, county, and census tract across birth cohorts.",
            "scripts": [
                "download.py --output_dir=raw_data",
                "preprocess.py --input_dir=raw_data --output_dir=input_files --nodownload",
                "../../tools/statvar_importer/stat_var_processor.py --input_data='input_files/*_cleaned.csv' --pv_map=opportunity_insights_outcomes_pvmap.csv --config_file=opportunity_insights_outcomes_metadata.csv --output_path=output_files/opportunity_insights_outcomes --output_counters=output_files/opportunity_insights_outcomes_counters.txt --existing_statvar_mcf=gs://unresolved_mcf/scripts/statvar/stat_vars.mcf"
            ],
            "import_inputs": [
                {
                    "template_mcf": "output_files/opportunity_insights_outcomes.tmcf",
                    "cleaned_csv": "output_files/opportunity_insights_outcomes.csv",
                    "node_mcf": "output_files/opportunity_insights_outcomes_stat_vars.mcf"
                }
            ],
            "source_files": [
                "raw_data/*.csv",
                "input_files/*_cleaned.csv",
                "output_files/opportunity_insights_outcomes_counters.txt"
            ],
            "cron_schedule": "0 8 1 * *",
            "resource_limits": {
                "cpu": 32,
                "memory": 512,
                "disk": 400
            }
        }
    ]
}

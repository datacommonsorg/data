{
  "schema_version": "1.0",
  "rules": [
    {
      "rule_id": "check_demographic_max_date_consistency",
      "validator": "MAX_DATE_CONSISTENT",
      "scope": {
        "data_source": "stats",
        "variables": {
          "dcids": [
            "Count_Person",
            "Count_Person_Male",
            "Count_Person_Female"
          ]
        }
      },
      "params": {}
    },
    {
      "rule_id": "check_demographic_min_observations_and_freshness",
      "validator": "SQL_VALIDATOR",
      "scope": {
        "data_source": "stats",
        "variables": {
          "dcids": [
            "Count_Person",
            "Count_Person_Male",
            "Count_Person_Female"
          ]
        }
      },
      "params": {
        "query": "SELECT StatVar, SUM(NumObservations) AS TotalObs, MAX(CAST(MaxDate AS INTEGER)) AS LatestDate FROM stats WHERE NumPlaces >= 500 GROUP BY StatVar",
        "condition": "(LatestDate <= 2022 AND TotalObs >= 1500) OR (LatestDate >= 2024 AND TotalObs >= 1500)",
        "failure_message": "Demographic population StatVar observation count or freshness validation failed."
      }
    }
  ]
}

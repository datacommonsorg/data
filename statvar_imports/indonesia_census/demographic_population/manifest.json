{
  "import_specifications": [
    {
      "import_name": "Indonesia_Census_Demographics",
      "curator_emails": ["support@datacommons.org"],
      "provenance_url": "https://www.bps.go.id/",
      "provenance_description": "Population Census and Demographic Statistics for Indonesia.",
      "scripts": ["run.sh"],
      "import_inputs": [
        {
          "template_mcf": "output_files/common_tmcf.tmcf",
          "import_processed_csv": "output_files/idn_population_historical_1971_2022.csv"
        },
        {
          "template_mcf": "output_files/common_tmcf.tmcf",
          "import_processed_csv": "output_files/idn_age_gender_historical_2010_2022.csv"
        },
        {
          "template_mcf": "output_files/idn_population_2023_2025.tmcf",
          "import_processed_csv": "output_files/idn_population_2023_2025.csv",
          "node_mcf": "output_files/idn_population_2023_2025_stat_vars.mcf"
        },
        {
          "template_mcf": "output_files/idn_age_gender_2023_2025.tmcf",
          "import_processed_csv": "output_files/idn_age_gender_2023_2025.csv",
          "node_mcf": "output_files/idn_age_gender_2023_2025_stat_vars.mcf"
        }
      ],
      "source_files": [
        "input_files/*.csv",
        "pvmaps/*.csv",
        "idn_demographic_metadata.csv",
        "idn_places_resolved.csv",
        "common_tmcf.tmcf",
        "counters/*.csv",
        "test_data/*.csv",
        "validation_config.json"
      ],
      "validation_config_file": "validation_config.json",
      "cron_schedule": "0 6 1 * *",
      "resource_limits": {
        "cpu": 4,
        "memory": 8,
        "disk": 50
      }
    }
  ]
}

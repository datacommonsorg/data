{
  "schema_version": "1.0",
  "definitions": {
    "scopes": {
      "active_demographic_statvars": {
        "data_source": "stats",
        "variables": {
          "dcids": [
            "Count_Person",
            "Count_Person_Male",
            "Count_Person_Female"
          ],
          "regex": [
            "^Count_Person_([0-9]+To[0-9]+Years|75OrMoreYears)(_Male|_Female)?$"
          ]
        }
      }
    }
  },
  "rules": [
    {
      "rule_id": "check_demographic_max_date_consistency",
      "validator": "MAX_DATE_CONSISTENT",
      "scope": "@active_demographic_statvars",
      "params": {}
    },
    {
      "rule_id": "check_demographic_num_places_consistency",
      "validator": "NUM_PLACES_CONSISTENT",
      "scope": "@active_demographic_statvars",
      "params": {}
    },
    {
      "rule_id": "check_demographic_min_observations_and_freshness",
      "validator": "SQL_VALIDATOR",
      "scope": "@active_demographic_statvars",
      "params": {
        "query": "SELECT StatVar, MAX(NumPlaces) AS MaxPlaces, SUM(NumObservations) AS TotalObs, MAX(CAST(MaxDate AS INTEGER)) AS LatestDate FROM stats WHERE StatVar NOT LIKE 'Count_Person_65OrMoreYears%' GROUP BY StatVar",
        "condition": "MaxPlaces >= 500 AND TotalObs >= 2000 AND LatestDate >= 2024",
        "failure_message": "Demographic population StatVar place count, observation count, or freshness validation failed."
      }
    }
  ]
}

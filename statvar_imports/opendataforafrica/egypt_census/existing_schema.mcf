# Existing Data Commons schema definitions referenced by Egypt_Census StatVars
# so schema_generator.py recognizes metadata properties, updated domainIncludes,
# single-type enum values, and compound disjunction enum values without emitting
# spurious provisional Property redefinitions (such as rangeIncludes: dcid:Class).

Node: dcid:alternateName
typeOf: dcs:Property
domainIncludes: dcid:Thing,dcid:StatisticalVariable,dcid:Person,dcid:Student,dcid:Teacher,dcid:Household,dcid:HealthEstablishment,dcid:Bed,dcid:CriminalIncidents,dcid:Establishment,dcid:Incident,dcid:MedicalConditionIncident,dcid:MortalityEvent,dcid:BirthEvent,dcid:EconomicActivity
rangeIncludes: dcid:Text

Node: dcid:nameWithLanguage
typeOf: dcs:Property
domainIncludes: dcid:Thing,dcid:StatisticalVariable,dcid:Person,dcid:Student,dcid:Teacher,dcid:Household,dcid:HealthEstablishment,dcid:Bed,dcid:CriminalIncidents,dcid:Establishment,dcid:Incident,dcid:MedicalConditionIncident,dcid:MortalityEvent,dcid:BirthEvent,dcid:EconomicActivity
rangeIncludes: dcid:Text

Node: dcid:descriptionUrl
typeOf: dcs:Property
domainIncludes: dcid:Thing,dcid:StatisticalVariable,dcid:Person,dcid:Student,dcid:Teacher,dcid:Household,dcid:HealthEstablishment,dcid:Bed,dcid:CriminalIncidents,dcid:Establishment,dcid:Incident,dcid:MedicalConditionIncident,dcid:MortalityEvent,dcid:BirthEvent,dcid:EconomicActivity
rangeIncludes: dcid:Text


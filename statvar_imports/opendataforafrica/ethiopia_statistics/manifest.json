{
    "import_specifications": [
        {
            "import_name": "EthiopiaStatistics",
            "curator_emails": [
                "support@datacommons.org"
            ],
            "provenance_url": "https://ethiopia.opendataforafrica.org/",
            "provenance_description": "Ethiopia Demographics, Health, Education, and Population statistics from Central Statistical Agency of Ethiopia via Open Data for Africa.",
            "scripts": [
                "download.sh",
                "../../../tools/statvar_importer/stat_var_processor.py --input_data=input_files/ethiopia_demographics.csv --pv_map=ethiopia-Ethiopia_Demographics_pvmap.csv --config_file=ethiopia-Ethiopia_Demographics_metadata.csv --places_resolved_csv=ethiopia-Ethiopia_Demographics_places_resolved.csv --output_path=output/ethiopia_demographics --output_counters=counters/ethiopia_demographics_counters.csv --existing_statvar_mcf=gs://unresolved_mcf/scripts/statvar/stat_vars.mcf",
                "../../../tools/statvar_importer/stat_var_processor.py --input_data=input_files/ethiopia_population_all_year.csv --pv_map=ethiopia-Ethiopia_Population_all_year_pvmap.csv --config_file=ethiopia-Ethiopia_Population_all_year_metadata.csv --output_path=output/ethiopia_population_all_year --output_counters=counters/ethiopia_population_all_year_counters.csv --existing_statvar_mcf=gs://unresolved_mcf/scripts/statvar/stat_vars.mcf",
                "../../../tools/statvar_importer/stat_var_processor.py --input_data=input_files/ethiopia_population_2007.csv --pv_map=ethiopia_population_2007_pvmap.csv --config_file=ethiopia_population_2007_metadata.csv --places_resolved_csv=ethiopia_population_2007_places_resolved.csv --output_path=output/ethiopia_population_2007 --output_counters=counters/ethiopia_population_2007_counters.csv --existing_statvar_mcf=gs://unresolved_mcf/scripts/statvar/stat_vars.mcf",
                "../../../tools/statvar_importer/stat_var_processor.py --input_data=input_files/ethiopia_population_projection_2022.csv --pv_map=ethiopia-Population_Projection_by_Region_and_Sex_2022_pvmap.csv --config_file=ethiopia-Population_Projection_by_Region_and_Sex_2022_metadata.csv --output_path=output/ethiopia_population_projection_2022 --output_counters=counters/ethiopia_population_projection_2022_counters.csv --existing_statvar_mcf=gs://unresolved_mcf/scripts/statvar/stat_vars.mcf",
                "../../../tools/statvar_importer/stat_var_processor.py --input_data=input_files/ethiopia_yusibcg.csv --pv_map=ethiopia-yusibcg_pvmap.csv --config_file=ethiopia-yusibcg_metadata.csv --places_resolved_csv=ethiopia-yusibcg_places_resolved.csv --output_path=output/ethiopia_yusibcg --output_counters=counters/ethiopia_yusibcg_counters.csv --existing_statvar_mcf=gs://unresolved_mcf/scripts/statvar/stat_vars.mcf"
            ],
            "import_inputs": [
                {
                    "template_mcf": "output/ethiopia_demographics.tmcf",
                    "cleaned_csv": "output/ethiopia_demographics.csv",
                    "node_mcf": "output/ethiopia_demographics*.mcf"
                },
                {
                    "template_mcf": "output/ethiopia_population_all_year.tmcf",
                    "cleaned_csv": "output/ethiopia_population_all_year.csv",
                    "node_mcf": "output/ethiopia_population_all_year*.mcf"
                },
                {
                    "template_mcf": "output/ethiopia_population_2007.tmcf",
                    "cleaned_csv": "output/ethiopia_population_2007.csv",
                    "node_mcf": "output/ethiopia_population_2007*.mcf"
                },
                {
                    "template_mcf": "output/ethiopia_population_projection_2022.tmcf",
                    "cleaned_csv": "output/ethiopia_population_projection_2022.csv",
                    "node_mcf": "output/ethiopia_population_projection_2022*.mcf"
                },
                {
                    "template_mcf": "output/ethiopia_yusibcg.tmcf",
                    "cleaned_csv": "output/ethiopia_yusibcg.csv",
                    "node_mcf": "output/ethiopia_yusibcg*.mcf"
                }
            ],
            "source_files": [
                "raw_files/*",
                "input_files/*",
                "counters/*",
                "validation_config.json"
            ],
            "validation_config_file": "validation_config.json",
            "cron_schedule": "0 5 * * 1",
            "resource_limits": {
                "cpu": 2,
                "memory": 4,
                "disk": 30
            }
        }
    ]
}

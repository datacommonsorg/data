{
    "import_specifications": [
        {
            "import_name": "Rwanda_Census",
            "curator_emails": [
                "support@datacommons.org"
            ],
            "provenance_url": "https://rwanda.opendataforafrica.org/",
            "provenance_description": "Rwanda Census: Demographics, Economy, Education",
            "scripts": [
                "download.sh",
                "../../../tools/statvar_importer/stat_var_processor.py --input_data=gcs_output/input_files/edvtatd.csv --pv_map=edvtatd_pv_map.csv --config_file=edvtatd_metadata.csv --output_path=gcs_output/output/edvtatd --output_counters=gcs_output/counters/edvtatd_counters.csv --statvar_dcid_remap_csv=edvtatd_statvar_remap.csv",
                "../../../tools/statvar_importer/stat_var_processor.py --input_data=gcs_output/input_files/eoefmac.csv --pv_map=eoefmac_pv_map.csv --config_file=eoefmac_metadata.csv --output_path=gcs_output/output/eoefmac --output_counters=gcs_output/counters/eoefmac_counters.csv",
                "../../../tools/statvar_importer/stat_var_processor.py --input_data=gcs_output/input_files/hivlaeg.csv --pv_map=hivlaeg_pv_map.csv --config_file=hivlaeg_metadata.csv --output_path=gcs_output/output/hivlaeg --output_counters=gcs_output/counters/hivlaeg_counters.csv",

{
    "schema_version": "1.0",
    "rules": [
        {
            "rule_id": "check_max_value_percentage",
            "description": "Checks that all percentage StatVars do not exceed 100%.",
            "validator": "MAX_VALUE_CHECK",
            "params": {
                "maximum": 100
            },
            "scope": {
                "variables": {
                    "contains_all": ["Percent"]
                }
            }
        },
        {
            "rule_id": "check_min_value_percentage",
            "description": "Checks that all percentage StatVars are not below 0%.",
            "validator": "MIN_VALUE_CHECK",
            "params": {
                "minimum": 0
            },
            "scope": {
                "variables": {
                    "contains_all": ["Percent"]
                }
            }
        },
        {
            "rule_id": "check_num_places_state_count",
            "description": "Checks observations cover 50 US states plus DC (50-52 entities).",
            "validator": "NUM_PLACES_COUNT",
            "params": {
                "minimum": 50,
                "maximum": 52
            }
        },
        {
            "rule_id": "check_statvar_max_dates",
            "description": "Verifies that MaxDate meets expected vintage per StatVar cohort.",
            "validator": "SQL_VALIDATOR",
            "params": {
                "query": "SELECT MIN(MaxDate) AS min_d, MAX(MaxDate) AS max_d FROM stats",
                "condition": "min_d >= '2016' AND max_d >= '2022'"
            }
        }
    ]
}

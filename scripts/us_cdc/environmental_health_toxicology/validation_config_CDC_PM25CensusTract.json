{
    "schema_version": "1.0",
    "rules": [
        {
            "rule_id": "check_max_date_consistent",
            "description": "Checks if the MaxDate is the same for all StatVars.",
            "validator": "MAX_DATE_CONSISTENT"
        },
        {
            "rule_id": "check_max_date_freshness",
            "description": "Verifies that dataset observation dates meet historical coverage boundary (>= 2005-01-01 across shards).",
            "validator": "SQL_VALIDATOR",
            "params": {
                "query": "SELECT MAX(MaxDate) AS latest_date FROM stats",
                "condition": "latest_date >= '2005-01-01'"
            }
        },
        {
            "rule_id": "check_deleted_records_percent",
            "description": "Disable deleted records check because differ is decoupled for high-scale Census Tracts.",
            "enabled": false
        },
        {
            "rule_id": "check_goldens_summary_report",
            "validator": "GOLDENS_CHECK",
            "params": {
                "golden_files": "../../../../golden_data/golden_summary_report_CDC_PM25CensusTract.csv",
                "input_files": "../../input0/genmcf/summary_report.csv"
            }
        },
        {
            "rule_id": "check_goldens_output_csv",
            "description": "Verifies the generated output CSV data matches established critical golden records",
            "validator": "GOLDENS_CHECK",
            "params": {
                "golden_files": "../../../../golden_data/golden_observations_CDC_PM25CensusTract.csv",
                "input_files": "../../../../output/PM2.5CensusTract_0.csv"
            }
        }
    ]
}

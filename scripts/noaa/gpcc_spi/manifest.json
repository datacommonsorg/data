{
  "import_specifications": [
    {
      "import_name": "NOAA_GPCC_StandardardizedPrecipitationIndex",
      "curator_emails": [
        "support@datacommons.org"
      ],
      "provenance_url": "https://opendata.dwd.de/climate_environment/GPCC/html/gpcc_monitoring_v2022_doi_download.html",
      "provenance_description": "Standardized Precipitation Index (Pearson distribution) data derived from NOAA GPCC monthly precipitation data.",
      "scripts": [
        "run.sh"
      ],
      "source_files": [
        "source_files/raw_data/*.nc",
        "golden_data/*.csv"
      ],
      "import_inputs": [
        {
          "template_mcf": "gpcc_spi.tmcf",
          "cleaned_csv": "output_files/gpcc_spi_pearson_*.csv"
        },
        {
          "template_mcf": "gpcc_spi_aggregation.tmcf",
          "cleaned_csv": "output_files/agg_gpcc_spi_pearson_*.csv"
        },
        {
          "template_mcf": "drought_spi_9m_polygon_place_svobs.tmcf",
          "cleaned_csv": "output_files/events_spi_9m_polygon/place_svobs/drought_spi_9m_polygon_place_svobs.csv"
        },
        {
          "template_mcf": "drought_spi_9m_polygon_events.tmcf",
          "cleaned_csv": "output_files/events_spi_9m_polygon/events/drought_spi_9m_polygon_events.csv"
        },
        {
          "template_mcf": "drought_spi_9m_polygon_svobs.tmcf",
          "node_mcf": "output_files/events_spi_9m_polygon/events/drought_event_nodes.mcf",
          "cleaned_csv": "output_files/events_spi_9m_polygon/event_svobs/drought_spi_9m_polygon_svobs.csv"
        }
      ],
      "validation_config_file": "validation_config.json",
      "cron_schedule": "30 05 12 * *"
    }
  ]
}

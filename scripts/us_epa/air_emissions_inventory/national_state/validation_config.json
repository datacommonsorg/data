{
    "schema_version": "1.0",
    "rules": [
        {
            "rule_id": "check_max_date_consistent",
            "description": "Checks that the latest date (MaxDate) is consistent across all StatVars.",
            "validator": "MAX_DATE_CONSISTENT",
            "params": {}
        },
        {
            "rule_id": "check_max_date_freshness",
            "description": "Verifies that MaxDate meets the expected freshness threshold (>= 2025) across all StatVars.",
            "validator": "SQL_VALIDATOR",
            "params": {
                "query": "SELECT StatVar, MaxDate FROM stats",
                "condition": "MaxDate >= '2025'"
            }
        }
    ]
}

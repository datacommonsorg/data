{
    "import_specifications": [
        {
            "import_name": "FAO_Currency",
            "curator_emails": [
                "support@datacommons.org"
            ],
            "provenance_url": "https://www.fao.org/faostat/en/#data/PE/metadata",
            "provenance_description": "The exchange rate of currency broken down by country, currency standardization type, and currency (using ISO 4217 Currency Code).",
            "scripts": [
                "download.sh",
                "preprocess.py"
            ],
            "source_files": [
                "CurrencyFAO.csv",
                "input_data/*.csv"
            ],
            "import_inputs": [
                {
                    "template_mcf": "output/CurrencyFAO.tmcf",
                    "cleaned_csv": "output/cleaned_output.csv"
                }
            ],
            "cron_schedule": "0 07 * * 4",
            "resource_limits": {
                "cpu": 2,
                "memory": 4,
                "disk": 20
            },
            "validation_config_file": "validation_config.json"
        }
    ]
}

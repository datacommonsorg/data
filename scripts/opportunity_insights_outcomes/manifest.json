{
    "import_specifications": [
        {
            "import_name": "OpportunityInsightsOutcomes",
            "curator_emails": [
                "support@datacommons.org"
            ],
            "provenance_url": "https://opportunityinsights.org/data/",
            "provenance_description": "The Opportunity Atlas (Opportunity Insights) social and economic mobility outcomes by childhood commuting zone, county, and census tract across birth cohorts.",
            "scripts": [
                "download.py",
                "preprocess.py"
            ],
            "import_inputs": [
                {
                    "template_mcf": "output/commuting_zone_outcomes_cleaned.tmcf",
                    "cleaned_csv": "output/commuting_zone_outcomes_cleaned.csv",
                    "node_mcf": "output/*.mcf"
                },
                {
                    "template_mcf": "output/county_outcomes_cleaned.tmcf",
                    "cleaned_csv": "output/county_outcomes_cleaned.csv"
                },
                {
                    "template_mcf": "output/tract_outcomes_cleaned.tmcf",
                    "cleaned_csv": "output/tract_outcomes_cleaned.csv"
                },
                {
                    "template_mcf": "output/tract_outcomes_late_simple_cleaned.tmcf",
                    "cleaned_csv": "output/tract_outcomes_late_simple_cleaned.csv"
                },
                {
                    "template_mcf": "output/county_by_cohort_outcomes_cleaned.tmcf",
                    "cleaned_csv": "output/county_by_cohort_outcomes_cleaned.csv"
                },
                {
                    "template_mcf": "output/cz_by_cohort_outcomes_cleaned.tmcf",
                    "cleaned_csv": "output/cz_by_cohort_outcomes_cleaned.csv"
                }
            ],
            "source_files": [
                "raw_data/*.csv",
                "counters/output_counters.csv"
            ],
            "cron_schedule": "0 8 1 * *",
            "validation_config_file": "validation_config.json",
            "resource_limits": {
                "cpu": 32,
                "memory": 512,
                "disk": 400
            }
        }
    ]
}
